:root{--bg:#F1F4F0;--card:#fff;--ink:#1B2A2F;--mute:#5B6B6F;--pine:#2F5D50;--brass:#B8862B;--line:#D5DDD6;--ok:#2F7D4F;--bad:#B3402F}
@media(prefers-color-scheme:dark){:root{--bg:#141C1E;--card:#1D282B;--ink:#E8EEEA;--mute:#9BAAA9;--pine:#6FB39F;--brass:#D9A94A;--line:#2F3D40}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2,h3{font-family:Georgia,"Times New Roman",serif;line-height:1.2;margin:.2em 0 .5em}
h1{font-size:1.9rem}
.top{position:sticky;top:0;z-index:5;display:flex;gap:12px;align-items:center;padding:10px 16px;background:var(--pine);color:#fff}
.top span{margin-left:auto;font-size:.9rem}
.top button{background:none;border:0;color:#fff;font-size:1.4rem;cursor:pointer}
.nav{position:fixed;inset:48px auto 0 0;width:250px;background:var(--card);border-right:1px solid var(--line);padding:12px;transform:translateX(-100%);transition:transform .2s;z-index:4;overflow:auto}
.nav.open{transform:none}
.nav a{display:block;padding:9px 12px;border-radius:6px;color:var(--ink);text-decoration:none}
.nav a.on,.nav a:hover{background:var(--pine);color:#fff}
main{max-width:760px;margin:0 auto;padding:20px 16px 60px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;margin:12px 0}
.btn{display:inline-block;background:var(--pine);color:#fff;border:0;border-radius:8px;padding:10px 16px;font:inherit;cursor:pointer;text-decoration:none}
.btn.alt{background:none;color:var(--pine);border:1px solid var(--pine)}
.btn:disabled{opacity:.5;cursor:not-allowed}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--brass);outline-offset:2px}
.bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--brass)}
.mute{color:var(--mute)}.lock{opacity:.55}
.list a{display:flex;justify-content:space-between;gap:8px;padding:10px 0;border-bottom:1px solid var(--line);color:var(--ink);text-decoration:none}
input,select{font:inherit;padding:8px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--ink)}
@media(min-width:900px){.nav{transform:none}.top #menuBtn{display:none}main{margin-left:270px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
